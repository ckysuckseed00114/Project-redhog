; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="RH: Redhog"
config/description="Ragnarok Online-inspired top-down action prototype"
run/main_scene="uid://duh1xkqhe1io6"
config/features=PackedStringArray("4.7")
config/icon="res://icon.svg"

[autoload]

GameConstants="*res://scripts/managers/game_constants.gd"
TextureGenerator="*res://scripts/managers/texture_generator.gd"
GlobalData="*uid://cu7lcfdytkgjm"
SupabaseClient="*uid://uakja8euq5ku"
DatabaseManager="*uid://86yjep8bcknl"
PauseMenu="*uid://1iou02rjp3y5"
PartyManager="*uid://pcnnfm0j2dy7"
OnlineSession="*res://scripts/online/online_session.gd"
BroadcastRouter="*res://scripts/online/broadcast_router.gd"
RealtimeChannelService="*res://scripts/online/realtime_channel_service.gd"
OnlinePresenceManager="*res://scripts/online/presence_manager.gd"
BossManager="*res://scripts/managers/boss_manager.gd"
WorldSyncManager="*res://scripts/online/world_sync_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[editor_plugins]

enabled=PackedStringArray()

